# Nerves U-Boot environment for the Seeed reComputer Industrial RK3576
#
# Compiled into uboot-env.bin and written raw at 15 MB (0xF00000) on the eMMC
# — see fwup_include/fwup-common.conf and rootfs_overlay/etc/fw_env.config.
#
# U-Boot (Radxa's vendor tree with Seeed's patches, CONFIG_ENV_IS_IN_BLK_DEV
# with ENV_OFFSET=0xF00000 on the boot device, the eMMC; see
# scripts/build-uboot.sh) loads this environment and runs `bootcmd` below,
# which implements A/B slot selection with automatic revert of unvalidated
# firmware.
#
# NOTE: loading a saved environment REPLACES U-Boot's built-in defaults, so
# the memory-layout variables from include/configs/rk3576_common.h are
# reproduced here.

# A/B boot with automatic revert, then fall back to extlinux/extlinux.conf on
# the FAT partition if the nerves boot path fails. If the saved env is ever
# corrupted, U-Boot ignores it entirely and its compiled-in default boot
# command (distro_bootcmd) finds the same extlinux config - automatic recovery
# either way.
bootcmd=run nerves_init nerves_boot; sysboot mmc 0:1 any ${scriptaddr} /extlinux/extlinux.conf

# From rk3576_common.h ENV_MEM_LAYOUT_SETTINGS (Radxa next-dev-v2024.10)
scriptaddr=0x40500000
pxefile_addr_r=0x40600000
fdtoverlay_addr_r=0x48200000
fdt_addr_r=0x48300000
kernel_addr_r=0x40400000
kernel_addr_c=0x45480000
ramdisk_addr_r=0x4a200000

#
# Nerves variables
#

nerves_fw_active=a

# Validation is performed by nerves_runtime's startup guard once all OTP
# applications start (autovalidate=0). If a newly-installed firmware fails
# to reach that point before the next boot, nerves_init reverts to the
# previous slot.
nerves_fw_autovalidate=0

# Set to 1 at factory-flash time (fwup complete) since that firmware is
# implicitly trusted.
nerves_fw_validated=1

# 0 on the first boot after an install; U-Boot sets it to 1 so a second
# boot without validation triggers the revert.
nerves_fw_booted=0

nerves_revert=\
    if test ${nerves_fw_active} = "a"; then\
        echo "Reverting to firmware slot B";\
        setenv nerves_fw_active "b";\
    else\
        echo "Reverting to firmware slot A";\
        setenv nerves_fw_active "a";\
    fi

nerves_init=\
    if test ${nerves_fw_booted} = 1; then\
        if test ${nerves_fw_validated} = 0; then\
            run nerves_revert;\
            setenv nerves_fw_validated 1;\
            saveenv;\
        fi;\
    else\
        setenv nerves_fw_booted 1;\
        if test ${nerves_fw_autovalidate} = 1; then\
            setenv nerves_fw_validated 1;\
        fi;\
        saveenv;\
    fi;\
    setenv bootfile Image.${nerves_fw_active};\
    setenv fdtfile rk3576-recomputer-industrial.${nerves_fw_active}.dtb;\
    if test ${nerves_fw_active} = "a"; then\
        setenv uenv_root PARTUUID=e7461250-672a-42ec-a738-0f38cf1e933d;\
    else\
        setenv uenv_root PARTUUID=187d8d14-28ac-429c-84cd-dc585a1b9b97;\
    fi

console=ttyFIQ0,1500000
cmdline=

nerves_setargs=setenv bootargs console=${console} root=${uenv_root} rootfstype=squashfs rootwait ${cmdline}

nerves_boot=\
    load mmc 0:1 ${kernel_addr_r} ${bootfile};\
    load mmc 0:1 ${fdt_addr_r} ${fdtfile};\
    run nerves_setargs;\
    booti ${kernel_addr_r} - ${fdt_addr_r}
