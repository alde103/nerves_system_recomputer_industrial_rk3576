# Drivers for the reComputer Industrial's own hardware, on top of
# rockchip_linux_defconfig and nerves.config.

# RS485/RS232: the WCH CH344 is CDC-ACM compliant, so the in-kernel cdc-acm
# driver serves both ports as /dev/ttyACM*. No vendor driver needed.
CONFIG_USB_ACM=y

# CAN-FD controller (can1 in the device tree, compatible
# "rockchip,rk3576-canfd"), plus the socket protocols userspace tools use.
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_BCM=y
CONFIG_CAN_GW=y
CONFIG_CANFD_RK3576=y

# gmac0's PHY is a Realtek RTL8211F; the defconfig only carries Motorcomm.
# Without it the PHY's RGMII delays are never configured. gmac1's Maxio
# MAE0621A works with the generic PHY driver.
CONFIG_REALTEK_PHY=y

# PCF85063 RTC on the SoM; PCF8563T on the carrier, whose countdown timer
# is wired to the reset circuit and exposed as a watchdog by Seeed's driver.
CONFIG_RTC_DRV_PCF85063=y
CONFIG_RTC_DRV_PCF8563=y

# 4G modules in the Mini PCIe slot: serial AT ports and QMI networking.
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_NET_QMI_WWAN=m
